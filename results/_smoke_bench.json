{
  "config": {
    "model": "checkpoints/hf/qwen3-0.6b-base",
    "arch": "auto",
    "dtype": "float32",
    "device": "cuda",
    "steps": 2,
    "k": 4,
    "n_train": 4,
    "n_holdout": 2,
    "temperature": 0.8,
    "top_p": 0.95,
    "max_new": 6,
    "save_every": 2,
    "out": "results/_smoke_bench.pt",
    "summary": "results/_smoke_bench.json",
