      "p1_greedy": 0.25,
      "p1_sampled": 0.25,
      "pass_at_k": 0.25,
      "wellformed_rate": 1.0,
      "wrong_wellformed": 15
    },
    "holdout": {
      "tasks": 2,
      "candidates": 10,
      "p1_greedy": 1.0,
      "p1_sampled": 1.0,
      "pass_at_k": 1.0,
      "wellformed_rate": 1.0,
      "wrong_wellformed": 0
    }
  }
